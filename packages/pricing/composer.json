{
    "name": "mycs/pricing",
    "description": "Prices one order line in decimal: coupon discount, tax inclusive or exclusive, rounded to cents. Framework-free.",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "brick/math": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MyCS\\Pricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyCS\\Pricing\\Tests\\": "tests/"
        }
    }
}
