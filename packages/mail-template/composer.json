{
    "name": "mycs/mail-template",
    "description": "Logic-less template renderer for staff-edited email/notification templates: placeholders, if/for, no code execution.",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MyCS\\MailTemplate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyCS\\MailTemplate\\Tests\\": "tests/"
        }
    }
}
