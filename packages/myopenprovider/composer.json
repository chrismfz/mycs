{
    "name": "nixpal/myopenprovider",
    "description": "Small, dependency-free Openprovider REST (v1) client and renewal logic.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Nixpal\\MyOpenprovider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nixpal\\MyOpenprovider\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "version": "1.0.0"
}
