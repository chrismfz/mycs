{
    "name": "mycs/vies",
    "description": "Checks an EU VAT number with the European Commission's VIES service (https, REST). Fails closed: an error is never a valid number. Framework-free.",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MyCS\\Vies\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyCS\\Vies\\Tests\\": "tests/"
        }
    }
}
