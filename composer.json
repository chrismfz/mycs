{
    "name": "mycs/mycs",
    "type": "project",
    "description": "MyCS: the control plane for hosting customers (accounts, catalogue, billing, provisioning, support).",
    "keywords": [
        "invoicing",
        "billing",
        "laravel",
        "open-source",
        "self-hosted",
        "subscription",
        "payment",
        "invoice",
        "billing software"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "andreiio/blade-remix-icon": "^3.6.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "directorytree/imapengine": "^1.15",
        "endroid/qr-code": "^5.0",
        "filament/filament": "^5.0",
        "flowframe/laravel-trend": "^0.5.0",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.9",
        "laravel/passport": "^13.7",
        "laravel/socialite": "^5.14",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "minishlink/web-push": "^11.0",
        "mycs/billing-period": "^1.0",
        "mycs/mail-template": "^1.0",
        "mycs/pricing": "^1.0",
        "nixpal/cardlink-eurobank": "^1.0",
        "nixpal/domain-tools": "^1.0",
        "nixpal/licensing": "^1.0",
        "nixpal/mailcow": "^1.0",
        "nixpal/myopenprovider": "^1.0",
        "nixpal/paypal-vault": "^1.0",
        "owen-it/laravel-auditing": "^14.0",
        "robthree/twofactorauth": "^3.0",
        "socialiteproviders/discord": "^4.2",
        "spatie/color": "^1.8",
        "spatie/laravel-query-builder": "^6.3",
        "timacdonald/json-api": "^1.0.0-beta.4",
        "willdurand/email-reply-parser": "^2.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "dedoc/scramble": "^0.13.0",
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "~5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "MyCS\\Extensions\\": "extensions/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "MyCS\\BillingPeriod\\Tests\\": "packages/billing-period/tests/",
            "MyCS\\MailTemplate\\Tests\\": "packages/mail-template/tests/",
            "MyCS\\Pricing\\Tests\\": "packages/pricing/tests/",
            "Nixpal\\CardlinkEurobank\\Tests\\": "packages/cardlink-eurobank/tests/",
            "Nixpal\\DomainTools\\Tests\\": "packages/domain-tools/tests/",
            "Nixpal\\Mailcow\\Tests\\": "packages/mailcow/tests/",
            "Nixpal\\MyOpenprovider\\Tests\\": "packages/myopenprovider/tests/",
            "Nixpal\\Licensing\\Tests\\": "packages/nixpal-licensing/tests/",
            "Nixpal\\PaypalVault\\Tests\\": "packages/paypal-vault/tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/FalseServer.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#c4b5fd,#fdba74\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=queue,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
