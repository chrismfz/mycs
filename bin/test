#!/usr/bin/env bash
# Fast local tests: SQLite on tmpfs, one database file per process, all cores (CLAUDE.md, «Tests»).
# Not :memory:: the settings are read from the database when the app boots, before an in-memory database is migrated.
#
#   bin/test                          the whole suite
#   bin/test tests/Feature/Foo.php    one file or directory (artisan test --parallel takes one path)
#   bin/test --filter=some_test       anything `php artisan test` takes
#   TEST_PROCESSES=4 bin/test         fewer processes (default: all cores)
#   bin/test --serial ...             one process, e.g. to read a single failure
set -euo pipefail
cd "$(dirname "$0")/.."

base="${TEST_TMPDIR:-$([ -w /dev/shm ] && echo /dev/shm || echo "${TMPDIR:-/tmp}")}"

# A full disk does not fail one test, it fails random ones far from the cause: the cron catches a Blade view it cannot
# compile into storage/, report() cannot write the log either, and the billing tests see a run that did nothing
# (2026-10-21: BillingCursorFuzzTest «flaked» with / at 100%). Refuse to start instead.
min_free_mb="${TEST_MIN_FREE_MB:-200}"
[[ $min_free_mb =~ ^[0-9]+$ ]] || { echo "bin/test: TEST_MIN_FREE_MB must be a whole number of MB, not '$min_free_mb'." >&2; exit 2; }
for path in storage "$base"; do
    free_kb="$(df -Pk "$path" 2>/dev/null | awk 'NR == 2 { print $4 }')" || true
    [[ $free_kb =~ ^[0-9]+$ ]] || { echo "bin/test: cannot read the free space under $path." >&2; exit 1; }
    free_mb=$(( free_kb / 1024 ))
    if [ "$free_mb" -lt "$min_free_mb" ]; then
        echo "bin/test: only ${free_mb} MB free under $path (needs ${min_free_mb}): tests would fail at random. Free some space first." >&2
        exit 1
    fi
done
dir="$(mktemp -d "$base/mycs-test.XXXXXX")"
trap 'rm -rf "$dir"' EXIT
touch "$dir/test.sqlite"

export DB_CONNECTION=sqlite
export DB_DATABASE="$dir/test.sqlite"
export APP_KEY="${APP_KEY:-base64:$(head -c32 /dev/urandom | base64)}"

if [ "${1:-}" = "--serial" ]; then
    shift
    php artisan test "$@"
    exit
fi

processes="${TEST_PROCESSES:-$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)}"
php artisan test --parallel --processes="$processes" "$@"
