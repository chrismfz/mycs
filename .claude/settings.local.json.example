{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__gsc-mcp",
      "mcp__github",
      "mcp__ekdosi"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
