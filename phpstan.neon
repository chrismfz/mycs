includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/
        - extensions/
        - packages/billing-period/src/
        - packages/pricing/src/
        - packages/mail-template/src/
        - packages/cardlink-eurobank/src/
        - packages/domain-tools/src/
        - packages/mailcow/src/
        - packages/myopenprovider/src/
        - packages/nixpal-licensing/src/
        - packages/paypal-vault/src/

    # Level 9 is the highest level
    level: 5

    # phpstan-baseline.neon holds the errors inherited from the fork's base (2026-10-11): CI fails only on
    # new ones. Fix a file's entries when you touch it, then regenerate with
    #   vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline
    reportUnmatchedIgnoredErrors: false
