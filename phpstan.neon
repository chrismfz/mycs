includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/
        - extensions/
        - packages/bank-alerts/src/
        - packages/billing-period/src/
        - packages/cnic/src
        - packages/gr-epp/src/
        - packages/pricing/src/
        - packages/mail-template/src/
        - packages/cardlink-eurobank/src/
        - packages/domain-tools/src/
        - packages/mailcow/src/
        - packages/myopenprovider/src/
        - packages/nixpal-licensing/src/
        - packages/paypal-vault/src/
        - packages/ticket-mail/src/
        - packages/ssl-tools/src/
        - packages/proxmox/src/

    # Level 9 is the highest level
    level: 5

    # phpstan-baseline.neon holds the errors inherited from the fork's base (2026-10-11): CI fails only on
    # new ones. Fix a file's entries when you touch it, then regenerate with
    #   vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline
    reportUnmatchedIgnoredErrors: false

    # The models' columns from the schema dump, through a copy its parser can read (phpstan-schema.php).
    bootstrapFiles:
        - phpstan-schema.php
    squashedMigrationsPath:
        - storage/framework/larastan
    # A model's casts() over the dump's column type (a tinyint(1) cast to boolean is a bool, as PHP sees it).
    parseModelCastsMethod: true
