# MyCS behind nginx (the devbox). Under Apache or LiteSpeed (cPanel) public/.htaccess does the same.
# Only public/index.php and public/zlic.php run PHP: an uploaded file under /storage is never code, whatever its name.
server {
    server_name mycs.example.com;
    root /var/www/mycs/public;
    index index.php;

    server_tokens off;
    client_max_body_size 32M;

    add_header X-Frame-Options            "SAMEORIGIN"                              always;
    add_header X-Content-Type-Options     "nosniff"                                 always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin"         always;
    add_header Permissions-Policy         "geolocation=(), microphone=(), camera=()" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/(index|zlic)\.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php-fpm/mycs.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 120s;
    }

    # Any other .php (an upload in /storage among them) is not run, and not served either.
    location ~ \.(php[0-9]?|phtml|phar|pht|phps)$ { return 404; }

    # Uploads are served as files, never as pages of this site.
    location ^~ /storage/ {
        add_header X-Content-Type-Options "nosniff" always;
        location ~ \.(php[0-9]?|phtml|phar|pht|phps)$ { return 404; }
    }

    location ~ /\.(?!well-known) { deny all; }

    listen 443 ssl;
    listen [::]:443 ssl;
    # ssl_certificate / ssl_certificate_key: certbot --nginx
}
