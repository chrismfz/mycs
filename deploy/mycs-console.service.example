# The customers' VPS consoles on a server that runs MyCS and the relay together (the devbox; docs/proxmox.md, B6).
# Next to the cluster, apart from MyCS, deploy/console-relay/ instead. /etc/systemd/system/mycs-console.service, then
#   systemctl daemon-reload && systemctl enable --now mycs-console
# Its config, /etc/mycs-console-relay/config.php (0600, owned by mycs; deploy/console-relay/config.php.example), has
# 'listen' => '127.0.0.1:8091', 'path' => '/console/ws' (nginx's location) and
# 'restart_file' => '/var/www/mycs/storage/framework/console-relay.restart': a deploy touches it at its end
# (deploy/update.sh), the relay exits, and Restart=always starts the release's code.
[Unit]
Description=MyCS console relay (noVNC to Proxmox)
After=network.target

[Service]
User=mycs
Group=mycs
Restart=always
RestartSec=3
WorkingDirectory=/var/www/mycs
# Its own memory, not php-cli's 128M: 64 consoles' buffers (Relay::BUDGET).
ExecStart=/usr/bin/php -d memory_limit=512M packages/proxmox/bin/console-relay /etc/mycs-console-relay/config.php
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
