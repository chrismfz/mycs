<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Packages">
            <directory>packages/billing-period/tests</directory>
            <directory>packages/pricing/tests</directory>
            <directory>packages/mail-template/tests</directory>
            <directory>packages/cardlink-eurobank/tests</directory>
            <directory>packages/domain-tools/tests</directory>
            <directory>packages/mailcow/tests</directory>
            <directory>packages/myopenprovider/tests</directory>
            <directory>packages/nixpal-licensing/tests</directory>
            <directory>packages/paypal-vault/tests</directory>
            <directory>packages/vies/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_DATABASE" value="mycs_test"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="CACHE_DRIVER" value="file" />
        <env name="SESSION_DRIVER" value="file" />
    </php>
</phpunit>
